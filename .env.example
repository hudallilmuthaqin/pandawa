# Copy to .env and replace every value. Never commit .env.

# --- Database ---
DB_NAME=pandawa
DB_USERNAME=pandawa
DB_PASSWORD=change-me-strong-db-password

# --- Security ---
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_TTL=12h
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- First admin (created once, only if no admin exists). Remove after first login. ---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-min-12-chars

# --- App ---
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8081
SWAGGER_ENABLED=false

# --- Demo data (testing only! keep false in production) ---
# With SPRING_PROFILES_ACTIVE=prod the seeder is always disabled.
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
