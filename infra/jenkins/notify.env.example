# Copy to ~/.config/pandawa/notify.env (outside the repo: it holds secrets), fill in, then restart Jenkins.
# Leave a channel's values empty to disable it.

# Shown at the end of every message
APP_URL=http://localhost:8090

# --- Email (SMTP) ---
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# Port 465 (smtps://) is standard. If the network blocks 465/587 (e.g. an office firewall), Gmail also accepts
# smtp://smtp.gmail.com:25: still encrypted, notify.sh requires STARTTLS (--ssl-reqd).
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=
# The 16-letter App Password (spaces as Google shows them are fine)
SMTP_PASSWORD=
MAIL_FROM=
# Comma-separated
MAIL_TO=

# --- WhatsApp (Fonnte, https://fonnte.com) ---
# Device token from the Fonnte dashboard (Device -> token) after scanning the QR code with the sending phone
FONNTE_TOKEN=
# Comma-separated: phone numbers (08xx or 628xx) and/or group ids (xxxx@g.us, see Fonnte "Get Whatsapp Group")
WA_TARGET=
